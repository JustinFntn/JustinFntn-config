{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Both Frontend and Backend",
      "dependsOn": ["Start Frontend", "Start Backend"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Start Frontend",
