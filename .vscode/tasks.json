    {
      "label": "Start Backend",
      "type": "shell",
      "command": "cd ./src/back; bun run dev",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
