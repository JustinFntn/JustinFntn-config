### Class Structure

```python
from abc import ABC, abstractmethod
from typing import Any, Dict, List, Optional

class BaseService(ABC):
    """Abstract base class for services."""
    
    def __init__(self, config: Dict[str, Any]) -> None:
        self.config = config
        self._initialize()
    
    @abstractmethod
    def _initialize(self) -> None:
        """Initialize the service."""
        pass
    
    @abstractmethod
    def process(self, data: Any) -> Any:
        """Process data."""
        pass

class UserService(BaseService):
    """Service for user operations."""
    
    def __init__(self, config: Dict[str, Any]) -> None:
        super().__init__(config)
        self.users: List[User] = []
    
    def _initialize(self) -> None:
        """Initialize user service."""
        self.db_connection = self._create_db_connection()
    
    def process(self, data: Dict[str, Any]) -> User:
        """Process user data and create user."""
        user = User(**data)
        self.users.append(user)
        return user
    
    def get_user_by_id(self, user_id: int) -> Optional[User]:
        """Get user by ID."""
        return next((u for u in self.users if u.id == user_id), None)
    
    def get_all_users(self) -> List[User]:
        """Get all users."""
        return self.users.copy()
```

### Error Handling

```python
import logging
from typing import Any, Optional
from contextlib import contextmanager

logger = logging.getLogger(__name__)

class CustomException(Exception):
    """Base exception for the application."""
    pass

class ValidationError(CustomException):
    """Raised when data validation fails."""
    pass

class DatabaseError(CustomException):
    """Raised when database operations fail."""
    pass

def safe_operation(func: Callable) -> Callable:
    """Decorator for safe operation execution."""
    def wrapper(*args: Any, **kwargs: Any) -> Any:
        try:
            return func(*args, **kwargs)
        except CustomException as e:
            logger.error(f"Custom error in {func.__name__}: {e}")
            raise
        except Exception as e:
            logger.error(f"Unexpected error in {func.__name__}: {e}")
            raise CustomException(f"Operation failed: {e}")
    return wrapper

@contextmanager
def database_transaction():
    """Context manager for database transactions."""
    try:
        # Begin transaction
        yield
        # Commit transaction
    except Exception as e:
        # Rollback transaction
        logger.error(f"Transaction failed: {e}")
        raise DatabaseError(f"Transaction failed: {e}")

# Usage example
@safe_operation
def create_user_safely(user_data: Dict[str, Any]) -> User:
    """Create user with proper error handling."""
    if not user_data.get('email'):
        raise ValidationError("Email is required")
    
    with database_transaction():
        user = User(**user_data)
        # Save to database
        return user
```

## FastAPI Application Structure

```python
# src/your_package/main.py
from fastapi import FastAPI, HTTPException, Depends
from fastapi.middleware.cors import CORSMiddleware
from fastapi.middleware.trustedhost import TrustedHostMiddleware
import uvicorn
from contextlib import asynccontextmanager

from .api.routes import router as api_router
from .core.config import settings
from .core.database import init_db

@asynccontextmanager
async def lifespan(app: FastAPI):
    """Application lifespan manager."""
    # Startup
    await init_db()
    yield
    # Shutdown
    # Cleanup resources

def create_app() -> FastAPI:
    """Create and configure FastAPI application."""
    app = FastAPI(
        title=settings.APP_NAME,
        version=settings.APP_VERSION,
        description=settings.APP_DESCRIPTION,
        lifespan=lifespan
    )
    
    # Add middleware
    app.add_middleware(
        CORSMiddleware,
        allow_origins=settings.ALLOWED_ORIGINS,
        allow_credentials=True,
        allow_methods=["*"],
        allow_headers=["*"],
    )
    
    app.add_middleware(
        TrustedHostMiddleware,
        allowed_hosts=settings.ALLOWED_HOSTS
    )
    
    # Include routers
    app.include_router(api_router, prefix="/api/v1")
    
    return app

app = create_app()

if __name__ == "__main__":
    uvicorn.run(
        "main:app",
        host=settings.HOST,
        port=settings.PORT,
        reload=settings.DEBUG
    )
```

