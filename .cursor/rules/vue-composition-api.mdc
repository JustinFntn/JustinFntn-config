# Vue 3 Composition API with TypeScript

## Introduction

This rule defines standards for developing Vue.js components using Composition API with TypeScript. It covers structure conventions, naming, state management, and best practices to maintain consistent and maintainable code.

## Recommended Component Structure

Vue components should follow this organization:

1. `<script setup lang="ts">` first
2. Imports (Vue core, composables, utilities, types, stores)
3. Props definition with `defineProps<T>()`
4. Emits definition with `defineEmits<T>()`
5. Reactive variables (`ref`, `reactive`, `computed`)
6. Custom composables and hooks
7. Functions and methods
8. Watchers (`watch`, `watchEffect`)
9. Lifecycle hooks (`onMounted`, `onUnmounted`, etc.)
10. `<template>` with clear structure
11. `<style scoped>` or `<style module>`

```vue
<script setup lang="ts">
import { ref, reactive, computed, watch, onMounted, onUnmounted } from 'vue'
import { useRouter, useRoute } from 'vue-router'
import { storeToRefs } from 'pinia'
import { useUserStore } from '@/stores/user'
import { ApiService } from '@/services/api'
import type { User, UserFormData } from '@/types/user'

// Props with TypeScript interface
interface Props {
  userId?: string
  isEditable?: boolean
  variant?: 'primary' | 'secondary'
}

// Props definition with default values
const props = withDefaults(defineProps<Props>(), {
  isEditable: false,
  variant: 'primary'
})

// Emits definition
interface Emits {
  'update:user': [user: User]
  'save': [userData: UserFormData]
  'cancel': []
}

const emit = defineEmits<Emits>()

// Stores and composables
const router = useRouter()
const route = useRoute()
const userStore = useUserStore()
const { currentUser } = storeToRefs(userStore)

// Local state
const isLoading = ref(false)
const error = ref<string | null>(null)
const formData = reactive<UserFormData>({
  name: '',
  email: '',
  role: 'user'
})

// Computed properties
const isFormValid = computed(() => {
  return formData.name.length > 0 && 
         formData.email.includes('@') &&
         !isLoading.value
})

const submitButtonText = computed(() => {
  return isLoading.value ? 'Saving...' : 'Save'
})

// Functions
const handleSubmit = async (): Promise<void> => {
  if (!isFormValid.value) return
  
  try {
    isLoading.value = true
    error.value = null
    
    const user = await ApiService.updateUser(props.userId!, formData)
    emit('save', formData)
    emit('update:user', user)
    
    await router.push('/users')
  } catch (err) {
    error.value = err instanceof Error ? err.message : 'Unknown error'
  } finally {
    isLoading.value = false
  }
}

const handleCancel = (): void => {
  emit('cancel')
  router.back()
}

// Watchers
watch(() => props.userId, async (newUserId) => {
  if (newUserId) {
    await loadUserData(newUserId)
  }
}, { immediate: true })

// Lifecycle
onMounted(async () => {
  if (props.userId) {
    await loadUserData(props.userId)
  }
})

onUnmounted(() => {
  // Cleanup if needed
})
</script>

<template>
  <div 
    :class="[
      'user-form',
      `user-form--${variant}`,
      { 'user-form--loading': isLoading }
    ]"
  >
    <form @submit.prevent="handleSubmit">
      <div class="form-group">
        <label for="name">Name</label>
        <input
          id="name"
          v-model="formData.name"
          type="text"
          :disabled="!isEditable || isLoading"
          required
        >
      </div>
      
      <div class="form-group">
        <label for="email">Email</label>
        <input
          id="email"
          v-model="formData.email"
          type="email"
          :disabled="!isEditable || isLoading"
          required
        >
      </div>
      
      <div v-if="error" class="error-message">
        {{ error }}
      </div>
      
      <div class="form-actions">
        <button
          type="submit"
          :disabled="!isFormValid"
          class="btn btn--primary"
        >
          {{ submitButtonText }}
        </button>
        
        <button
          type="button"
          @click="handleCancel"
          class="btn btn--secondary"
        >
          Cancel
        </button>
      </div>
    </form>
  </div>
</template>

<style scoped>
.user-form {
  @apply max-w-md mx-auto p-6 bg-white rounded-lg shadow-md;
}

.user-form--loading {
  @apply opacity-75 pointer-events-none;
}

.form-group {
  @apply mb-4;
}

.form-group label {
  @apply block text-sm font-medium text-gray-700 mb-2;
}

.form-group input {
  @apply w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500;
}

.error-message {
  @apply text-red-600 text-sm mb-4;
}

.form-actions {
  @apply flex gap-3;
}

.btn {
  @apply px-4 py-2 rounded-md font-medium transition-colors;
}

.btn--primary {
