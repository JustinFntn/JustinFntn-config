## Validation with VeeValidate

```vue
<script setup lang="ts">
import { useForm } from 'vee-validate'
import { toTypedSchema } from '@vee-validate/zod'
import { z } from 'zod'

const schema = toTypedSchema(
  z.object({
    name: z.string().min(1, 'Name is required').min(2, 'Minimum 2 characters'),
    email: z.string().email('Invalid email'),
    age: z.number().min(18, 'Must be at least 18 years old')
  })
)

const { defineField, handleSubmit, errors, meta } = useForm({
  validationSchema: schema,
  initialValues: {
    name: '',
    email: '',
    age: 0
  }
})

const [name, nameAttrs] = defineField('name')
const [email, emailAttrs] = defineField('email')
const [age, ageAttrs] = defineField('age')

const onSubmit = handleSubmit((values) => {
  console.log('Valid data:', values)
})
</script>

<template>
  <form @submit="onSubmit">
    <div>
      <input v-model="name" v-bind="nameAttrs" placeholder="Name" />
      <span v-if="errors.name" class="error">{{ errors.name }}</span>
    </div>
    
    <div>
      <input v-model="email" v-bind="emailAttrs" type="email" placeholder="Email" />
      <span v-if="errors.email" class="error">{{ errors.email }}</span>
    </div>
    
    <button type="submit" :disabled="!meta.valid">
      Submit
    </button>
  </form>
</template>
```

## Custom Directives

```typescript
// directives/focus.ts
import type { Directive } from 'vue'

export const vFocus: Directive = {
  mounted(el: HTMLElement) {
    el.focus()
  }
}

// directives/click-outside.ts
export const vClickOutside: Directive = {
  mounted(el: HTMLElement, binding) {
    el._clickOutside = (event: Event) => {
      if (!(el === event.target || el.contains(event.target as Node))) {
        binding.value(event)
      }
    }
    document.addEventListener('click', el._clickOutside)
  },
  unmounted(el: HTMLElement) {
    document.removeEventListener('click', el._clickOutside)
    delete el._clickOutside
  }
}
```

## Anti-Patterns to Avoid

### ❌ Avoid
```vue
<!-- Mixing Options API and Composition API -->
<script>
export default {
  data() {
    return { count: 0 }
  }
}
</script>

<script setup>
import { ref } from 'vue'
const message = ref('Hello')
</script>

<!-- Direct prop mutation -->
<script setup>
const props = defineProps<{ items: Item[] }>()
props.items.push(newItem) // ❌ Never mutate props directly
</script>

<!-- Non-reactive variables for state -->
<script setup>
let count = 0 // ❌ Not reactive
const increment = () => count++
</script>
```

### ✅ Recommended
```vue
<script setup lang="ts">
import { ref, computed } from 'vue'

// Proper reactive state
const count = ref(0)
const message = ref('Hello')

// Computed for derived values
const doubleCount = computed(() => count.value * 2)

// Event emission to communicate with parent
const emit = defineEmits<{
  'update:items': [items: Item[]]
}>()

const addItem = (item: Item) => {
  const newItems = [...props.items, item]
  emit('update:items', newItems)
}
</script>
```

## Testing with Vitest

```typescript
// UserCard.test.ts
import { describe, it, expect, vi } from 'vitest'
import { mount } from '@vue/test-utils'
import UserCard from '@/components/UserCard.vue'
import type { User } from '@/types/user'

const mockUser: User = {
  id: '1',
  name: 'John Doe',
  email: 'john@example.com',
  role: 'user',
  isActive: true,
  createdAt: new Date(),
  updatedAt: new Date()
}

describe('UserCard', () => {
  it('displays user information', () => {
    const wrapper = mount(UserCard, {
      props: { user: mockUser }
    })

    expect(wrapper.text()).toContain('John Doe')
    expect(wrapper.text()).toContain('john@example.com')
  })

  it('emits event on click', async () => {
    const wrapper = mount(UserCard, {
      props: { user: mockUser }
    })

    await wrapper.find('.user-card').trigger('click')
    
    expect(wrapper.emitted('select')).toBeTruthy()
    expect(wrapper.emitted('select')?.[0]).toEqual([mockUser])
  })
})
```

## Performance and Optimizations

- Use `shallowRef` for large objects that don't change often
- Prefer `computed` over `watch` when possible
- Use `v-once` for static content
- Implement `v-memo` for complex lists
- Lazy load components with `defineAsyncComponent`
- Use `markRaw` for non-reactive objects (e.g., class instances)

```vue
<script setup lang="ts">
import { shallowRef, markRaw } from 'vue'
import { defineAsyncComponent } from 'vue'

// Lazy loading
const HeavyComponent = defineAsyncComponent(() => import('./HeavyComponent.vue'))

// Large object in shallow
const bigData = shallowRef(hugeDatabaseResult)

// Non-reactive object
const chartInstance = markRaw(new Chart(canvas, config))
</script>
